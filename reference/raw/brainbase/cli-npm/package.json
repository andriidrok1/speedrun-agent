{
  "name": "@brainbase-labs/cli",
  "version": "0.37.0",
  "description": "Pack, share, and install agent templates across harnesses (Claude Code, Codex, ...).",
  "type": "module",
  "bin": {
    "brainbase": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun run scripts/build.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "verify": "bun run scripts/check-bun-version.ts && bun run typecheck && bun test && bun run build",
    "prepublishOnly": "bun run verify"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BrainbaseHQ/cli.git"
  },
  "homepage": "https://github.com/BrainbaseHQ/cli#readme",
  "bugs": {
    "url": "https://github.com/BrainbaseHQ/cli/issues"
  },
  "keywords": [
    "brainbase",
    "cli",
    "agents",
    "claude-code",
    "codex",
    "templates",
    "ai"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.2",
    "@clack/prompts": "^0.7.0",
    "eventsource": "^3.0.2",
    "ink": "^5.1.0",
    "picocolors": "^1.0.0",
    "react": "^18.3.1",
    "smol-toml": "^1.6.1",
    "tar": "^7.5.22",
    "yaml": "^2.8.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/tar": "^6.1.13",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=18"
  }
}
